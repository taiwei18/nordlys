---
import Footer from '@/components/layout/Footer.astro'
import Header from '@/components/layout/Header.astro'
import BaseLayout, {
  type Props as BaseLayoutProps
} from '@/layouts/BaseLayout.astro'
import { getPosts } from '@/util/posts'
import { toDateString } from '@/util'

export type Props = BaseLayoutProps & {
  frontmatter: { showLatestPost?: boolean }
}

const { frontmatter } = Astro.props

const allPosts = await getPosts()
const recentPosts = allPosts.slice(0, 6)
---

<BaseLayout frontmatter={frontmatter}>
  <div class="flex min-h-screen flex-col">
    <Header activeHeaderLink="首页" />

    <main id="main" class="mx-auto flex w-full max-w-2xl flex-1 flex-col px-5 sm:px-6 md:px-0">
      <!-- Precision Hero Section -->
      <section class="relative mb-10 sm:mb-14 pt-1 sm:pt-3">
        <div class="relative max-w-xl">
          <!-- Main Heading with Dual Tone & Terminal Point -->
          <h1 class="font-sans text-3xl sm:text-5xl lg:text-[3.25rem] font-medium tracking-[-0.035em] leading-[1.18]">
            <span class="block overflow-hidden pb-1">
              <span data-title-line class="block text-body font-normal">把复杂的技术，</span>
            </span>
            <span class="block overflow-hidden pb-1 mt-1">
              <span data-title-line class="inline-flex items-baseline flex-wrap font-semibold text-title">
                <span>写得</span>
                <span class="text-accent mx-0.5 drop-shadow-[0_0_18px_rgba(var(--accent),0.25)]">清楚</span>
                <span class="inline-block size-2 sm:size-2.5 bg-accent rounded-[1px] ml-1.5 shadow-[0_0_10px_rgba(var(--accent),0.5)] transition-all duration-300 ease-out hover:scale-125 hover:shadow-[0_0_14px_rgba(var(--accent),0.9)]" aria-hidden="true"></span>
              </span>
            </span>
          </h1>

          <!-- Tactile Action Bar -->
          <div data-entrance class="mt-7 sm:mt-8 flex flex-wrap items-center gap-3.5 text-xs font-mono">
            <a
              href="/about/"
              data-magnetic
              class="group inline-flex items-center gap-2 rounded-[2px] border border-border-medium bg-surface/90 px-3.5 py-1.5 font-sans text-xs font-medium text-title shadow-sm transition-all duration-200 hover:border-accent hover:text-accent active:scale-[0.98]"
            >
              <span>关于 TaiWei</span>
              <span class="text-accent transition-transform duration-200 ease-out group-hover:translate-x-0.5" aria-hidden="true">→</span>
            </a>

            <a
              href="/posts/"
              class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs text-muted transition-colors hover:text-title"
            >
              <span>浏览全部文章</span>
              <span class="text-[10px] text-faint tabular-nums font-mono">({allPosts.length})</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Articles Section -->
      <section class="mb-20">
        <div class="mb-2 flex items-end justify-between border-b border-border-subtle pb-4 font-mono">
          <h2 class="font-sans text-xl font-medium tracking-tight text-title">精选文章</h2>
          <a href="/posts/" data-magnetic class="group inline-flex items-center gap-1.5 font-mono text-xs text-muted transition-colors hover:text-title">
            <span>查看全部 ({allPosts.length})</span>
            <span class="flex size-3.5 items-center justify-center border border-border-subtle bg-surface font-mono text-[9px] text-muted transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-0.5 group-hover:border-accent group-hover:text-accent" aria-hidden="true">→</span>
          </a>
        </div>

        <div class="flex flex-col">
          {
            recentPosts.map((post, index) => (
              <article data-reveal class="post-row group border-b border-border-subtle py-6 sm:py-7">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                  <a href={`/posts/${post.id}/`} class="interactive-underline inline-flex items-start gap-2.5 text-base font-medium tracking-tight text-title sm:text-lg no-underline" data-astro-prefetch>
                    <span class="font-mono text-xs text-accent font-normal mt-1 opacity-70 group-hover:opacity-100 transition-opacity">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span>{post.data.title}</span>
                    <span aria-hidden="true" class="post-arrow flex size-4 shrink-0 items-center justify-center border border-border-subtle bg-surface/80 text-[10px] text-accent mt-1 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]">
                      <span class="iconify tabler--arrow-up-right text-[11px]"></span>
                    </span>
                  </a>
                  <time class="shrink-0 font-mono text-xs text-muted tabular-nums" datetime={post.data.publishedDate.toISOString()}>
                    {toDateString(post.data.publishedDate)}
                  </time>
                </div>
                <p class="mt-3 max-w-xl text-xs sm:text-sm leading-relaxed text-muted line-clamp-2 pl-6 sm:pl-7">
                  {post.data.description}
                </p>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
