---
import AdjacentPostsBar from '@/components/AdjacentPostsBar.astro'
import TagsBar from '@/components/TagsBar.astro'
import ToC from '@/components/ToC.astro'
import PageLayout, {
  type Props as PageLayoutProps
} from '@/layouts/PageLayout.astro'
import HeadingAnchorsPlugin from '@/plugins/HeadingAnchorsPlugin.astro'
import { resolveImageUrl, toDateString } from '@/util'
import { resolveTags } from '@/util/tags'
import { render, type CollectionEntry } from 'astro:content'
import config from '@/theme.config'

export interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props

const {
  Content,
  remarkPluginFrontmatter: { readingTime, wordCount },
  headings
} = await render(post)

const canonicalURL = new URL(
  post.data.canonicalURL || Astro.url.pathname,
  Astro.site
).href
const authorURL = new URL(
  `/authors/${encodeURIComponent(post.data.author)}/`,
  Astro.site
).href
const openGraphImage = post.data.openGraphImage || `/posts/${post.id}.png`
const openGraphImageUrl = new URL(resolveImageUrl(openGraphImage), Astro.site).href
const dateModified = post.data.updatedDate || post.data.publishedDate

const frontmatter: PageLayoutProps['frontmatter'] = {
  ...post.data,
  canonicalURL,
  openGraphImage,
  openGraphType: 'article',
  updatedDate: dateModified,
  activeHeaderLink: 'Blog',
  scrollProgress: true
}

const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  url: canonicalURL,
  datePublished: post.data.publishedDate.toISOString(),
  dateModified: dateModified.toISOString(),
  author: {
    '@type': 'Person',
    name: post.data.author,
    url: authorURL
  },
  publisher: {
    '@type': 'Person',
    name: config.author,
    url: new URL('/about/', Astro.site).href
  },
  image: {
    '@type': 'ImageObject',
    url: openGraphImageUrl,
    width: 1200,
    height: 630
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL
  },
  keywords: post.data.tags,
  articleSection: post.data.tags[0],
  wordCount,
  inLanguage: config.locale
}

frontmatter.structuredData = articleStructuredData
frontmatter.keywords = [post.data.title, ...post.data.tags]
---

<PageLayout {frontmatter}>
  <div slot="top" class="animate-fade-in-up mt-4">
    <a
      href="/posts/"
      class="group inline-flex w-fit items-center gap-1.5 text-current/80 transition-colors duration-200 hover:text-accent active:scale-95"
    >
      <span
        class="iconify tabler--arrow-left text-xl transition-transform duration-200 group-hover:-translate-x-1"
      ></span>
      Back to all posts
    </a>
  </div>

  <h1 class="animate-fade-in-up animation-delay-100 mt-2 mb-2 sm:my-4">
    {frontmatter.title}
  </h1>
  <div class="animate-fade-in-up animation-delay-150">
    <TagsBar tags={resolveTags(post.data.tags)} />
  </div>

  <div class="animate-fade-in-up animation-delay-200 mt-4">
    <span class="opacity-75"
      >Published on <time datetime={post.data.publishedDate.toISOString()}
        >{toDateString(post.data.publishedDate)}</time
      > by</span
    >
    <a class="clickable" href={`/authors/${post.data.author}/`}
      >{post.data.author}</a
    > · <span class="whitespace-nowrap opacity-75">{readingTime} </span>
  </div>

  {
    !!post.data.showToC && (
      <div
        slot="aside"
        class="border-accent mt-24 hidden border-r pr-4 opacity-75 transition duration-500 ease-in-out hover:opacity-100 2xl:block"
      >
        <ToC {headings} open />
      </div>
    )
  }{
    !!post.data.showToC && (
      <div class="mt-8 w-fit rounded-sm border 2xl:hidden">
        <ToC {headings} />
      </div>
    )
  }

  <article
    data-pagefind-body
    data-pagefind-filter="type:post"
    class="animate-fade-in-up animation-delay-300"
  >
    <Content />
  </article>

  <AdjacentPostsBar {post} slot="bottom" />
  <HeadingAnchorsPlugin />

  <style>
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in-up {
      animation: fadeInUp 0.6s ease-out forwards;
    }

    .animation-delay-100 {
      opacity: 0;
      animation-delay: 0.1s;
    }

    .animation-delay-150 {
      opacity: 0;
      animation-delay: 0.15s;
    }

    .animation-delay-200 {
      opacity: 0;
      animation-delay: 0.2s;
    }

    .animation-delay-300 {
      opacity: 0;
      animation-delay: 0.3s;
    }
  </style>
</PageLayout>
