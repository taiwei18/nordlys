---
import type { ResolvedTag } from '@/types'

export interface Props {
  tags: ResolvedTag[]
}

const { tags } = Astro.props
---

<div class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
  {
    tags.map(({ tag, icon }) => {
      const isHash = icon === 'tabler--hash'
      return (
        <a
          class="group inline-flex items-center gap-1.5 no-underline opacity-75 transition-all duration-200 hover:opacity-100 hover:text-accent active:scale-95"
          href={`/tags/${tag}/`}
        >
          <span
            class={`iconify shrink-0 text-base leading-none transition-transform duration-200 group-hover:scale-110 group-hover:rotate-6 ${isHash ? 'text-accent/80' : ''} ${icon}`}
          />
          <span class="leading-none font-normal">{tag}</span>
        </a>
      )
    })
  }
</div>
