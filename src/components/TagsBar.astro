---
import type { ResolvedTag } from '@/types'

export interface Props {
  tags: ResolvedTag[]
}

const { tags } = Astro.props
---

<div class="flex flex-wrap gap-1.5 text-xs">
  {
    tags.map(({ tag }) => {
      return (
        <a
          class="font-mono text-xs text-muted hover:text-title hover:bg-surface-hover border border-border-subtle hover:border-border-medium px-2 py-0.5 rounded transition-all duration-150"
          href={`/tags/${tag}/`}
        >
          #{tag}
        </a>
      )
    })
  }
</div>
