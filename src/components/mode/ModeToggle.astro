<dark-light-toggle class="flex items-center">
  <button
    title="Toggle dark & light mode"
    class="group flex size-11 items-center justify-center rounded-full text-muted transition-colors duration-200 hover:bg-surface-hover hover:text-title active:scale-90 sm:size-auto sm:rounded sm:p-1.5"
    aria-label="Toggle dark & light mode"
  >
    <span
      aria-hidden="true"
      class="iconify tabler--moon dark:tabler--sun text-base transition-transform duration-300 ease-out group-hover:rotate-12"
    ></span>
  </button>
</dark-light-toggle>

<script>
  class DarkLightToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button')

      if (!button) return

      button.setAttribute('aria-label', window.mode.getMode())

      const handleToggle = (event: MouseEvent) => {
        const newMode = window.mode.getMode() === 'light' ? 'dark' : 'light'

        const switchMode = () => {
          window.mode.setMode(newMode)
          button.setAttribute('aria-label', newMode)
        }

        const useSimpleTransition =
          !document.startViewTransition ||
          window.matchMedia('(pointer: coarse)').matches ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches

        // Mobile browsers have inconsistent View Transition support. Apply the
        // mode synchronously there so a tap can never be swallowed by a
        // partially implemented transition API.
        if (useSimpleTransition) {
          switchMode()
          return
        }

        const x = event.clientX
        const y = event.clientY
        const endRadius = Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y)
        )

        try {
          const transition = document.startViewTransition(switchMode)

          transition.ready
            .then(() => {
              document.documentElement.animate(
                {
                  clipPath: [
                    `circle(0px at ${x}px ${y}px)`,
                    `circle(${endRadius}px at ${x}px ${y}px)`
                  ]
                },
                {
                  duration: 450,
                  easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
                  pseudoElement: '::view-transition-new(root)'
                }
              )
            })
            .catch(() => {})
        } catch {
          switchMode()
        }
      }

      button.addEventListener('click', handleToggle)
    }
  }

  if (!customElements.get('dark-light-toggle'))
    customElements.define('dark-light-toggle', DarkLightToggle)
</script>

<style is:global>
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  ::view-transition-new(root) {
    z-index: 9999;
  }
  ::view-transition-old(root) {
    z-index: 1;
  }
</style>
