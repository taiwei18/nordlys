---
import HeaderItem from '@/components/layout/HeaderItem.astro'
import type { NavItemParent } from '@/types'
import { generateItemId } from '@/util'

export interface Props {
  item: NavItemParent
  activeHeaderLink?: string
}

const {
  item: { children, icon, label },
  activeHeaderLink
} = Astro.props

const isActive = children.some(
  (item) => activeHeaderLink === item.label || activeHeaderLink === item.href
)

const instanceId = crypto.randomUUID()
const buttonId = generateItemId(`${label}-${instanceId}-button`)
const menuId = generateItemId(`${label}-${instanceId}-menu`)
---

<dropdown-parent
  class="relative block sm:inline-block"
  data-open="false"
  data-is-active={String(isActive)}
>
  <button
    id={buttonId}
    aria-haspopup="true"
    aria-controls={menuId}
    aria-expanded="false"
    class:list={[
      'group relative flex min-h-11 w-full cursor-pointer items-center gap-1.5 whitespace-nowrap transition-colors duration-150 sm:min-h-0 sm:w-auto sm:py-1',
      { 'text-title font-medium': isActive },
      { 'text-muted hover:text-title': !isActive }
    ]}
  >
    {
      icon && (
        <span
          class={`iconify text-xl transition-transform duration-300 group-hover:-translate-y-0.5 ${icon}`}
        />
      )
    }
    <span class="relative">
      {label}
      <span
        class={`absolute -bottom-1 left-0 h-[1.5px] w-full origin-left bg-accent transition-transform duration-250 ease-out ${
          isActive ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100 group-focus-visible:scale-x-100'
        }`}
      ></span>
    </span>
    <span
      aria-hidden="true"
      class="iconify tabler--chevron-down ml-auto text-xl transition-transform duration-300 ease-out group-hover:translate-y-0.5 sm:ml-0"
    ></span>
  </button>

  <ul
    id={menuId}
    role="menu"
    aria-labelledby={buttonId}
    hidden
    inert
    class="dropdown-surface mt-1 w-full flex-col gap-1 border border-border-medium bg-surface p-1.5 sm:absolute sm:right-0 sm:z-20 sm:mt-3 sm:min-w-[150px] sm:w-auto"
  >
    {
      children.map((item) => (
        <li
          role="none"
          class="transition-colors duration-150 hover:bg-accent/10"
        >
          <div class="px-2.5 sm:py-1">
            <HeaderItem
              role="menuitem"
              {item}
              isActive={
                activeHeaderLink === item.label ||
                activeHeaderLink === item.href
              }
            />
          </div>
        </li>
      ))
    }
  </ul>
</dropdown-parent>

<script>
  class Dropdown extends HTMLElement {
    private controller?: AbortController
    private animation?: Animation

    disconnectedCallback() {
      this.controller?.abort()
      this.animation?.cancel()
    }

    connectedCallback() {
      this.controller?.abort()
      this.controller = new AbortController()
      const { signal } = this.controller
      const button = this.querySelector('button')
      const menu = this.querySelector('ul')

      if (!button || !menu) return

      const items = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'))
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
      reduced.addEventListener('change', () => {
        this.animation?.cancel()
        menu.hidden = this.dataset.open !== 'true'
      }, { signal })
      const setOpen = (open: boolean, focus = false) => {
        this.animation?.cancel()
        this.dataset.open = String(open)
        button.setAttribute('aria-expanded', String(open))
        menu.inert = !open
        if (!open && menu.contains(document.activeElement)) button.focus()
        if (open) menu.hidden = false
        if (reduced.matches) {
          menu.hidden = !open
        } else {
          this.animation = menu.animate(
            open
              ? [{ opacity: 0, transform: 'translateY(-6px)' }, { opacity: 1, transform: 'translateY(0)' }]
              : [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-4px)' }],
            { duration: open ? 220 : 150, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
          )
          this.animation.onfinish = () => { menu.hidden = !open }
        }
        if (open && focus) items[0]?.focus()
      }

      button.addEventListener('click', (event) => {
        setOpen(this.dataset.open !== 'true', event.detail === 0)
      }, { signal })

      this.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.dataset.open === 'true') {
          event.preventDefault()
          event.stopPropagation()
          setOpen(false)
          button.focus()
        }
        if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
          event.preventDefault()
          if (this.dataset.open !== 'true') setOpen(true)
          const current = items.indexOf(document.activeElement as HTMLAnchorElement)
          const next = event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1
            : event.key === 'ArrowDown' ? (current + 1) % items.length
            : current < 0 ? items.length - 1 : (current - 1 + items.length) % items.length
          items[next]?.focus()
        }
      }, { signal })

      document.addEventListener('click', (event) => {
        if (!this.contains(event.target as Node) && this.dataset.open === 'true') setOpen(false)
      }, { signal })
      this.addEventListener('focusout', (event) => {
        if (!this.contains(event.relatedTarget as Node) && this.dataset.open === 'true') setOpen(false)
      }, { signal })
    }
  }

  if (!customElements.get('dropdown-parent'))
    customElements.define('dropdown-parent', Dropdown)
</script>
