---
import logo from "@/assets/logo.svg";
import Dropdown from "@/components/Dropdown.astro";
import HeaderItem from "@/components/layout/HeaderItem.astro";
import MobileNavToggle from "@/components/layout/MobileNavToggle.astro";
import ModeToggle from "@/components/mode/ModeToggle.astro";
import config from "@/theme.config";
import type {
  HeaderItem as HeaderItemType,
  NavItem as NavItemType,
} from "@/types";
import { Image } from "astro:assets";

export interface Props {
  activeHeaderLink?: string;
}

const { activeHeaderLink } = Astro.props;

export const isNavItem = (item: HeaderItemType): item is NavItemType =>
  Object.hasOwn(item, "href");
---

<header class="w-full pt-6 pb-10 sm:pt-14 sm:pb-16 transition-colors duration-300">
  <div class="mx-auto flex max-w-2xl items-center justify-between px-5 sm:px-6 md:px-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-title focus:px-3 focus:py-1 focus:text-canvas font-mono text-xs">
      Skip to content
    </a>

    <!-- Wordmark & Logo Mark -->
    <a
      href="/"
      class="group flex items-center gap-2.5 text-title hover:opacity-80 transition-opacity"
      transition:name="branding"
    >
      <div class="h-6 w-6 text-title transition-transform duration-300 group-hover:scale-105">
        <Image
          src={logo}
          alt={`${config.title} logo`}
          width={24}
          height={24}
          class="h-full w-full object-contain"
        />
      </div>
      <span class="font-sans font-medium text-sm tracking-tight text-title">
        {config.title}
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-6 sm:flex">
      <ul class="flex items-center gap-5 text-sm">
        {
          config.navbarItems.map((item) => (
            <li>
              {isNavItem(item) ? (
                <HeaderItem
                  {item}
                  isActive={
                    activeHeaderLink === item.label ||
                    activeHeaderLink === item.href
                  }
                />
              ) : (
                <Dropdown {item} {activeHeaderLink} />
              )}
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-3 border-l border-border-subtle pl-5">
        <a
          href="/search/"
          class="text-muted hover:text-title transition-colors text-xs font-mono p-1 rounded hover:bg-surface-hover"
          aria-label="Search"
        >
          <span class="iconify tabler--search text-base"></span>
        </a>

        {config.modeToggle && <ModeToggle />}
      </div>
    </nav>

    <!-- Mobile Nav Toggle -->
    <div class="flex items-center gap-3 sm:hidden">
      <a
        href="/search/"
        class="flex size-11 items-center justify-center rounded-full text-muted hover:text-title hover:bg-surface-hover transition-colors"
        aria-label="Search"
      >
        <span class="iconify tabler--search text-lg"></span>
      </a>
      {config.modeToggle && <ModeToggle />}
      <MobileNavToggle />
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-nav" class="hidden sm:hidden hairline-bottom px-5 pt-2 pb-5 mt-2">
    <nav aria-label="Mobile navigation">
      <ul class="flex flex-col gap-1 text-sm">
        {
          config.navbarItems.map((item) => (
            <li>
              {isNavItem(item) ? (
                <HeaderItem
                  {item}
                  isActive={
                    activeHeaderLink === item.label ||
                    activeHeaderLink === item.href
                  }
                />
              ) : (
                <Dropdown {item} {activeHeaderLink} />
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
