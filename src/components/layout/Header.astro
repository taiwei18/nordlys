---
import logo from "@/assets/logo.svg";
import Dropdown from "@/components/Dropdown.astro";
import HeaderItem from "@/components/layout/HeaderItem.astro";
import MobileNavToggle from "@/components/layout/MobileNavToggle.astro";
import ModeToggle from "@/components/mode/ModeToggle.astro";
import config from "@/theme.config";
import type {
  HeaderItem as HeaderItemType,
  NavItem as NavItemType,
} from "@/types";
import { Image } from "astro:assets";

export interface Props {
  activeHeaderLink?: string;
}

const { activeHeaderLink } = Astro.props;

export const isNavItem = (item: HeaderItemType): item is NavItemType =>
  Object.hasOwn(item, "href");
---

<header id="site-header" class="site-header sticky top-0 z-40 w-full mb-8 sm:mb-12 transition-[background-color,border-color,backdrop-filter] duration-300">
  <div class="mx-auto flex max-w-2xl items-center justify-between border-b border-border-subtle/80 px-5 py-4 sm:px-6 md:px-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-[2px] focus:bg-title focus:px-3 focus:py-1 focus:text-canvas font-mono text-xs">
      Skip to content
    </a>

    <!-- Wordmark & Logo Mark -->
    <a
      href="/"
      class="group flex items-center gap-2.5 text-title transition-colors hover:text-accent select-none"
      transition:name="branding"
    >
      <div class="h-6 w-6 text-title transition-transform duration-300 group-hover:rotate-[-6deg] group-hover:scale-105">
        <Image
          loading="eager"
          src={logo}
          alt={`${config.title} logo`}
          width={24}
          height={24}
          class="h-full w-full object-contain"
        />
      </div>
      <span class="font-sans text-sm sm:text-base font-semibold tracking-tight text-title">
        {config.title}
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-6 sm:flex">
      <ul class="flex items-center gap-6 text-sm">
        {
          config.navbarItems.map((item) => (
            <li>
              {isNavItem(item) ? (
                <HeaderItem
                  {item}
                  isActive={
                    activeHeaderLink === item.label ||
                    activeHeaderLink === item.href
                  }
                />
              ) : (
                <Dropdown {item} {activeHeaderLink} />
              )}
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2.5 border-l border-border-subtle pl-4">
        <a
          href="/search/"
          class="flex size-8 items-center justify-center rounded-[2px] text-muted transition-colors hover:text-title hover:bg-surface active:scale-95"
          aria-label="Search"
        >
          <span class="iconify tabler--search text-base"></span>
        </a>

        {config.modeToggle && <ModeToggle />}
      </div>
    </nav>

    <!-- Mobile Nav Controls -->
    <div class="flex items-center gap-1.5 sm:hidden">
      <a
        href="/search/"
        class="flex size-9 items-center justify-center rounded-[2px] text-muted transition-colors hover:text-title hover:bg-surface"
        aria-label="Search"
      >
        <span class="iconify tabler--search text-lg"></span>
      </a>
      {config.modeToggle && <ModeToggle />}
      <MobileNavToggle />
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-nav" data-open="false" class="mobile-nav-panel sm:hidden border-b border-border-subtle/80 bg-surface/95 backdrop-blur-xl" inert aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <ul class="flex flex-col gap-1 px-5 pt-3 pb-5 text-sm">
        {
          config.navbarItems.map((item) => (
            <li>
              {isNavItem(item) ? (
                <HeaderItem
                  {item}
                  isActive={
                    activeHeaderLink === item.label ||
                    activeHeaderLink === item.href
                  }
                />
              ) : (
                <Dropdown {item} {activeHeaderLink} />
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  let cleanupHeader = () => {}

  const setupHeaderMotion = () => {
    cleanupHeader()
    const controller = new AbortController()
    const { signal } = controller
    const header = document.querySelector<HTMLElement>('#site-header')

    if (header) {
      const handleScroll = () => {
        if (window.scrollY > 20) {
          header.classList.add('header-scrolled')
        } else {
          header.classList.remove('header-scrolled')
        }
      }
      handleScroll()
      window.addEventListener('scroll', handleScroll, { passive: true, signal })
    }

    cleanupHeader = () => {
      controller.abort()
    }
  }

  document.addEventListener('astro:page-load', setupHeaderMotion)
  document.addEventListener('astro:before-swap', () => cleanupHeader())
</script>
