---
const { class: className, ...rest } = Astro.props
---

<div
  class={`prose prose-lg max-w-full dark:prose-invert prose-h1:text-4xl prose-code:before:content-none! prose-code:after:content-none! sm:prose-h1:text-5xl prose-em:pr-0.5 ${className}`}
  {...rest}
>
  <slot />
</div>

<style is:global>
  .prose code:not(.expressive-code code) {
    color: var(--text-title);
    background-color: var(--card-hover);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding-inline: 0.35rem;
    padding-block: 0.125rem;
    font-size: 0.875em;
    font-weight: 500;
  }
</style>
