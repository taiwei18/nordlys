---
import FooterItem from '@/components/layout/FooterItem.astro'
import config from '@/theme.config'

const currentYear = new Date().getFullYear()
---

<footer class="mt-auto w-full pb-[max(2rem,env(safe-area-inset-bottom))] pt-10 transition-colors duration-300 sm:pb-12 sm:pt-14">
  <div class="mx-auto flex max-w-2xl flex-col items-start justify-between gap-4 border-t border-border-subtle px-5 pt-5 sm:flex-row sm:items-center sm:px-6 md:px-0">
    <div class="font-mono text-xs text-muted">
      &#169; {currentYear} {config.author}
    </div>

    <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-muted">
      {config.footerItems.map((item) => <FooterItem {item} />)}
    </div>
  </div>
</footer>
