---
import FooterItem from '@/components/layout/FooterItem.astro'
import config from '@/theme.config'

const currentYear = new Date().getFullYear()
---

<footer class="mt-auto w-full pt-14 pb-[max(2rem,env(safe-area-inset-bottom))] sm:pt-16 sm:pb-12 transition-colors duration-300">
  <div class="mx-auto flex max-w-2xl flex-col sm:flex-row items-start sm:items-center justify-between gap-4 px-5 sm:px-6 md:px-0 border-t border-border-subtle pt-6">
    <div class="font-mono text-xs text-muted">
      &#169; {currentYear} {config.author}
    </div>

    <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-muted">
      {config.footerItems.map((item) => <FooterItem {item} />)}
    </div>
  </div>
</footer>
