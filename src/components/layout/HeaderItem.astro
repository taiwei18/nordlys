---
import type { NavItem } from '@/types'
import { isAbsolute } from '@/util'
import type { JSX } from 'astro/jsx-runtime'

export interface Props {
  item: NavItem
  isActive?: boolean
  role?: JSX.AriaRole
}

const {
  isActive = false,
  item: { href, icon, label },
  role
} = Astro.props
---

<a
  href={href}
  class={`group/nav relative inline-flex min-h-11 items-center gap-1.5 transition-colors duration-150 sm:min-h-0 sm:py-1 ${
    isActive
      ? 'text-title font-medium'
      : 'text-muted hover:text-title'
  }`}
  target={isAbsolute(href) ? '_blank' : '_self'}
  {role}
>
  {
    icon && (
      <span class={`iconify text-sm ${icon}`} />
    )
  }
  <span class="relative">
    {label}
    <span
      class={`absolute -bottom-1 left-0 h-[1.5px] w-full origin-left bg-accent transition-transform duration-250 ease-out ${
        isActive
          ? 'scale-x-100'
          : 'scale-x-0 group-hover/nav:scale-x-100 group-focus-visible/nav:scale-x-100'
      }`}
    ></span>
  </span>
</a>
