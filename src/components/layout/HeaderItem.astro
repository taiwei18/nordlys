---
import type { NavItem } from '@/types'
import { isAbsolute } from '@/util'
import type { JSX } from 'astro/jsx-runtime'

export interface Props {
  item: NavItem
  isActive?: boolean
  role?: JSX.AriaRole
}

const {
  isActive = false,
  item: { href, icon, label },
  role
} = Astro.props
---

<a
  href={href}
  class={`relative inline-flex items-center gap-1.5 transition-colors duration-150 py-0.5 ${
    isActive
      ? 'text-title font-medium'
      : 'text-muted hover:text-title'
  }`}
  target={isAbsolute(href) ? '_blank' : '_self'}
  {role}
>
  {
    icon && (
      <span class={`iconify text-sm ${icon}`} />
    )
  }
  <span class="relative">
    {label}
    <span
      class={`absolute -bottom-0.5 left-0 h-[1.5px] rounded-full bg-title transition-all duration-200 ease-out ${
        isActive ? 'w-full opacity-100' : 'w-0 opacity-0 group-hover:w-full group-hover:opacity-100'
      }`}
    ></span>
  </span>
</a>
