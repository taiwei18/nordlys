<mobile-nav-toggle>
  <button
    class="group flex items-center justify-center rounded-full p-1.5 text-current/80 transition-all duration-200 hover:bg-accent/10 hover:text-accent active:scale-90"
    title="Toggle mobile nav"
    aria-label="closed"
  >
    <span
      aria-hidden="true"
      id="mobile-nav-icon"
      class="iconify tabler--menu-2 text-2xl transition-transform duration-300 group-hover:scale-110"
    ></span>
  </button>
</mobile-nav-toggle>

<script>
  class MobileNavToggle extends HTMLElement {
    connectedCallback() {
      const iconOpen = 'tabler--x'
      const iconClosed = 'tabler--menu-2'

      const nav = document.querySelector('#mobile-nav')
      const icon = this.querySelector('#mobile-nav-icon')
      const button = this.querySelector('button')

      if (!nav || !icon || !button) return

      const navIsOpen = () => !nav.classList.contains('hidden')

      const close = () => {
        nav.classList.add('hidden')
        icon.classList.replace(iconOpen, iconClosed)
        button.setAttribute('aria-label', 'closed')
      }

      const open = () => {
        nav.classList.remove('hidden')
        icon.classList.replace(iconClosed, iconOpen)
        button.setAttribute('aria-label', 'open')
      }

      const handleToggle = () => {
        if (navIsOpen()) close()
        else open()
      }

      button.addEventListener('click', handleToggle)
    }
  }

  if (!customElements.get('mobile-nav-toggle'))
    customElements.define('mobile-nav-toggle', MobileNavToggle)
</script>
