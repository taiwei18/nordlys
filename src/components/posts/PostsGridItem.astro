---
import TagsBar from "@/components/TagsBar.astro";
import { toDateString } from "@/util";
import { resolveTags } from "@/util/tags";
import { Image } from "astro:assets";
import { type CollectionEntry } from "astro:content";

export interface Props {
  post: CollectionEntry<"posts">;
}

const { id, data } = Astro.props.post;
---

<div class="group relative flex h-full flex-col gap-2 md:gap-4 md:p-4">
  <div class="hidden justify-end md:flex">
    <time
      class="mt-2 text-sm opacity-75 transition-opacity duration-200 group-hover:opacity-100 sm:mt-0"
      datetime={data.publishedDate.toISOString()}
    >
      {toDateString(data.publishedDate)}
    </time>
  </div>

  <div class="flex justify-start md:justify-center">
    {
      data.previewImage && (
        <div class="overflow-hidden rounded-md">
          <Image
            src={data.previewImage}
            height={208}
            alt={`${data.title} preview`}
            class="mt-0 mb-0 max-h-52 w-fit object-contain transition-transform duration-500 ease-out group-hover:scale-105 md:h-32"
          />
        </div>
      )
    }
  </div>

  <a
    class="group/title inline-flex items-center gap-1.5 text-xl font-medium transition-colors duration-200 group-hover:text-accent"
    href={`/posts/${id}/`}
    data-astro-prefetch
  >
    <span>{data.title}</span>
    <span
      class="iconify tabler--arrow-right text-accent text-lg opacity-0 -translate-x-2 transition-all duration-300 ease-out group-hover:opacity-100 group-hover:translate-x-0"
    />
  </a>

  <div class="flex justify-start md:hidden">
    <time
      class="mt-2 text-sm opacity-75 transition-opacity duration-200 group-hover:opacity-100 sm:mt-0"
      datetime={data.publishedDate.toISOString()}
    >
      {toDateString(data.publishedDate)}
    </time>
  </div>

  <div class="flex w-full justify-start">
    <TagsBar tags={resolveTags(data.tags)} />
  </div>

  <div class="opacity-75 transition-opacity duration-200 group-hover:opacity-90">
    {data.description}
  </div>
</div>
