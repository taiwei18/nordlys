---
import { toDateString } from '@/util'
import type { CollectionEntry } from 'astro:content'

export interface Props {
  posts: CollectionEntry<'posts'>[]
}

const { posts } = Astro.props
---

<div class="flex flex-col divide-y divide-border-subtle">
  {
    posts.map((post) => {
      const { id, data } = post
      return (
        <article class="group py-6 first:pt-0 last:pb-0 transition-transform duration-200 hover:translate-x-1">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 sm:gap-4 mb-2">
            <a
              class="font-sans text-lg font-medium text-title group-hover:opacity-80 transition-opacity duration-150 inline-flex items-center gap-1.5"
              href={`/posts/${id}/`}
              data-astro-prefetch
            >
              <span>{data.title}</span>
              <span class="iconify tabler--arrow-up-right text-xs opacity-0 -translate-x-1 translate-y-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0 text-muted"></span>
            </a>
            <time
              class="shrink-0 font-mono text-xs text-muted"
              datetime={data.publishedDate.toISOString()}
            >
              {toDateString(data.publishedDate)}
            </time>
          </div>

          <p class="text-sm text-body leading-relaxed font-sans line-clamp-2">
            {data.description}
          </p>

          <div class="mt-3 flex flex-wrap items-center gap-1.5">
            {
              data.tags.map((tag: string) => (
                <a
                  href={`/tags/${tag}/`}
                  class="font-mono text-xs text-muted hover:text-title hover:bg-surface-hover px-1.5 py-0.5 rounded transition-colors"
                >
                  #{tag}
                </a>
              ))
            }
          </div>
        </article>
      )
    })
  }
</div>
