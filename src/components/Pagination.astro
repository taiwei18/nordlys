---
import type { Page } from 'astro'

export interface Props {
  page: Page
}

const { page } = Astro.props

const normalizePageUrl = (url: string) => {
  const normalized = url === '/posts/1' ? '/posts/' : `${url}/`
  return normalized.replace(/\/+/g, '/')
}
---

{
  page.lastPage > 1 && (
    <nav data-reveal class="mb-8 flex w-full grow items-end justify-center border-t border-border-subtle pt-6">
      <div class="flex items-center gap-4 font-mono text-xs">
        {page.url.prev ? (
          <a data-magnetic class="text-muted transition-colors hover:text-accent" href={normalizePageUrl(page.url.prev)}>
            Previous
          </a>
        ) : (
          <span class="opacity-25" aria-disabled="true">
            Previous
          </span>
        )}
        {page.currentPage} / {page.lastPage}
        {page.url.next ? (
          <a
            data-magnetic
            class="text-muted transition-colors hover:text-accent"
            href={normalizePageUrl(page.url.next)}
          >
            Next
          </a>
        ) : (
          <span class="opacity-25" aria-disabled="true">
            Next
          </span>
        )}
      </div>
    </nav>
  )
}
