---
import type { Page } from 'astro'

export interface Props {
  page: Page
}

const { page } = Astro.props

const normalizePageUrl = (url: string) => {
  const normalized = url === '/posts/1' ? '/posts/' : `${url}/`
  return normalized.replace(/\/+/g, '/')
}
---

{
  page.lastPage > 1 && (
    <nav class="mb-8 flex w-full grow items-end justify-center">
      <div class="flex gap-4">
        {page.url.prev ? (
          <a class="clickable" href={normalizePageUrl(page.url.prev)}>
            Previous
          </a>
        ) : (
          <span class="opacity-25" aria-disabled="true">
            Previous
          </span>
        )}
        {page.currentPage} / {page.lastPage}
        {page.url.next ? (
          <a
            class={!page.url.next ? 'no-underline opacity-25' : 'clickable'}
            href={normalizePageUrl(page.url.next)}
          >
            Next
          </a>
        ) : (
          <span class="opacity-25" aria-disabled="true">
            Next
          </span>
        )}
      </div>
    </nav>
  )
}
