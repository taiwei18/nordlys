---
import PagefindPlugin from '@/plugins/PagefindPlugin.astro'
import PageLayout, {
  type Props as PageLayoutProps
} from '@/layouts/PageLayout.astro'
import { getPosts } from '@/util/posts'

const frontmatter: PageLayoutProps['frontmatter'] = {
  title: '搜索',
  description: '搜索 TaiWei 博客中的前端开发、工程化、AI 编码工具与小程序实践文章。',
  robots: 'noindex,follow',
  activeHeaderLink: '/search'
}

const searchDocuments = (await getPosts(undefined, undefined, false)).map(
  ({ id, data }) => ({
    title: data.title,
    description: data.description,
    tags: data.tags,
    url: `/posts/${id}/`
  })
)
const serializedSearchDocuments = JSON.stringify(searchDocuments).replace(
  /</g,
  '\\u003c'
)
---

<PageLayout {frontmatter}>
  <div class="mb-8 pb-4 hairline-bottom">
    <h1 class="font-sans text-2xl sm:text-3xl font-semibold tracking-tight text-title">
      搜索
    </h1>
    <p class="mt-2 text-sm text-muted">检索全站文章与技术主题</p>
  </div>

  <search-input class="relative flex w-full flex-col gap-4 mb-8">
    <div class="relative w-full">
      <input
        type="search"
        aria-label="搜索文章"
        autocomplete="off"
        placeholder="输入关键词进行搜索..."
        class="w-full bg-surface text-title placeholder:text-muted pl-4 pr-16 py-3 rounded-lg border border-border-subtle focus:border-border-strong focus:outline-none transition-colors font-sans text-base sm:text-sm"
      />
      <button id="search-clear" class="invisible absolute right-1 top-1/2 flex min-h-11 min-w-11 -translate-y-1/2 cursor-pointer items-center justify-center font-mono text-xs text-muted hover:text-title">
        ESC
      </button>
    </div>
  </search-input>

  <div class="pb-2 mb-4">
    <h2 id="results-heading" aria-live="polite" class="font-mono text-xs text-muted uppercase tracking-wider">
      等待输入...
    </h2>
  </div>

  <ul id="results-list" class="list-none p-0 flex flex-col divide-y divide-border-subtle"></ul>

  <script
    is:inline
    id="search-documents"
    type="application/json"
    set:html={serializedSearchDocuments}
  />
  <PagefindPlugin />
</PageLayout>

<script>
  import {
    searchDocuments,
    type SearchDocument,
    type SearchResult
  } from '@/util/search'

  const SEARCH_DELAY = 300
  const RESULT_LIMIT = 15

  const readSearchDocuments = (): SearchDocument[] => {
    const data =
      document.querySelector<HTMLScriptElement>(
        '#search-documents'
      )?.textContent

    return data ? JSON.parse(data) : []
  }

  class SearchInput extends HTMLElement {
    private timeoutId?: number
    private requestId = 0

    connectedCallback() {
      const searchInput = this.querySelector<HTMLInputElement>('input')
      const clearBtn = this.querySelector<HTMLButtonElement>('button')
      const resultsHeading =
        document.querySelector<HTMLElement>('#results-heading')
      const resultsContainer =
        document.querySelector<HTMLUListElement>('#results-list')

      if (!searchInput || !clearBtn || !resultsHeading || !resultsContainer)
        return

      const documents = readSearchDocuments()

      const setStatus = (message: string) => {
        resultsHeading.textContent = message
      }

      const clearResults = () => resultsContainer.replaceChildren()

      const renderResults = (results: SearchResult[], total: number) => {
        clearResults()

        for (const result of results.slice(0, RESULT_LIMIT)) {
          const item = document.createElement('li')
          const link = document.createElement('a')
          const excerpt = document.createElement('div')

          item.className = 'py-4 first:pt-0 transition-transform duration-200 hover:translate-x-1'
          link.className = 'font-sans text-base font-medium text-title hover:opacity-80 transition-opacity block'
          link.href = result.url
          link.textContent = result.title
          excerpt.className = 'text-xs text-muted mt-1 line-clamp-2 leading-relaxed font-sans'
          excerpt.textContent = result.excerpt
          item.append(link, excerpt)
          resultsContainer.append(item)
        }

        if (total > RESULT_LIMIT) {
          const remaining = document.createElement('li')
          remaining.className = 'font-mono text-xs text-muted text-center py-3'
          remaining.textContent = `+ 另有 ${total - RESULT_LIMIT} 条结果未展开`
          resultsContainer.append(remaining)
        }
      }

      const performSearch = async (query: string) => {
        const trimmedQuery = query.trim()

        if (!trimmedQuery) {
          clearResults()
          setStatus('等待输入...')
          clearBtn.classList.add('invisible')
          return
        }

        clearBtn.classList.remove('invisible')
        setStatus('正在搜索...')

        const currentRequestId = ++this.requestId

        try {
          if (window.pagefind) {
            const pagefindResults = await window.pagefind.search(trimmedQuery)
            if (this.requestId !== currentRequestId) return

            const detailedResults = await Promise.all(
              pagefindResults.results.map((result) => result.data())
            )
            if (this.requestId !== currentRequestId) return

            const normalizedResults: SearchResult[] = detailedResults.map(
              (item) => ({
                url: item.url,
                title: item.meta.title,
                excerpt: item.excerpt
              })
            )

            if (!normalizedResults.length) {
              clearResults()
              setStatus(`未找到匹配 "${trimmedQuery}" 的内容`)
              return
            }

            setStatus(`找到 ${normalizedResults.length} 条结果`)
            renderResults(normalizedResults, normalizedResults.length)
            return
          }
        } catch {
          // fallback
        }

        const localResults = searchDocuments(documents, trimmedQuery)
        if (this.requestId !== currentRequestId) return

        if (!localResults.length) {
          clearResults()
          setStatus(`未找到匹配 "${trimmedQuery}" 的内容`)
          return
        }

        setStatus(`找到 ${localResults.length} 条结果`)
        renderResults(localResults, localResults.length)
      }

      searchInput.addEventListener('input', () => {
        window.clearTimeout(this.timeoutId)
        this.timeoutId = window.setTimeout(
          () => performSearch(searchInput.value),
          SEARCH_DELAY
        )
      })

      clearBtn.addEventListener('click', () => {
        searchInput.value = ''
        clearResults()
        setStatus('等待输入...')
        clearBtn.classList.add('invisible')
        searchInput.focus()
      })

      // 支持从 URL ?q= 参数初始化搜索
      const urlQuery = new URLSearchParams(window.location.search).get('q')
      if (urlQuery) {
        searchInput.value = urlQuery
        performSearch(urlQuery)
      }
    }
  }

  if (!customElements.get('search-input'))
    customElements.define('search-input', SearchInput)
</script>
