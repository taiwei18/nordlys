---
import PagefindPlugin from '@/plugins/PagefindPlugin.astro'
import PageLayout, {
  type Props as PageLayoutProps
} from '@/layouts/PageLayout.astro'
import { getPosts } from '@/util/posts'

const frontmatter: PageLayoutProps['frontmatter'] = {
  title: '搜索',
  description: '搜索 TaiWei 博客中的前端开发、工程化、AI 编码工具与小程序实践文章。',
  robots: 'noindex,follow',
  activeHeaderLink: '/search'
}

const searchDocuments = (await getPosts(undefined, undefined, false)).map(
  ({ id, data }) => ({
    title: data.title,
    description: data.description,
    tags: data.tags,
    url: `/posts/${id}/`
  })
)
const serializedSearchDocuments = JSON.stringify(searchDocuments).replace(
  /</g,
  '\\u003c'
)
---

<PageLayout {frontmatter}>
  <h1>{frontmatter.title}</h1>
  <search-input class="flex w-full items-center justify-center gap-4 sm:gap-8">
    <input
      type="search"
      aria-label="搜索文章"
      autocomplete="off"
      placeholder="输入关键词搜索文章"
      class="border-accent soft-input w-full rounded-sm border p-4 sm:w-[50%]"
    />
    <button id="search-clear" class="clickable invisible text-xl">清空</button>
  </search-input>
  <h2 id="results-heading" aria-live="polite">输入关键词搜索文章</h2>
  <ul id="results-list" class="list-none p-0"></ul>

  <script
    is:inline
    id="search-documents"
    type="application/json"
    set:html={serializedSearchDocuments}
  />
  <PagefindPlugin />
</PageLayout>

<script>
  import {
    searchDocuments,
    type SearchDocument,
    type SearchResult
  } from '@/util/search'

  const SEARCH_DELAY = 300
  const RESULT_LIMIT = 15

  const readSearchDocuments = (): SearchDocument[] => {
    const data =
      document.querySelector<HTMLScriptElement>(
        '#search-documents'
      )?.textContent

    return data ? JSON.parse(data) : []
  }

  const toPlainText = (value: string) => {
    const parsed = new DOMParser().parseFromString(value, 'text/html')
    return parsed.body.textContent ?? ''
  }

  class SearchInput extends HTMLElement {
    private timeoutId?: number
    private requestId = 0

    connectedCallback() {
      const searchInput = this.querySelector<HTMLInputElement>('input')
      const clearBtn = this.querySelector<HTMLButtonElement>('button')
      const resultsHeading =
        document.querySelector<HTMLElement>('#results-heading')
      const resultsContainer =
        document.querySelector<HTMLUListElement>('#results-list')

      if (!searchInput || !clearBtn || !resultsHeading || !resultsContainer)
        return

      const documents = readSearchDocuments()

      const setStatus = (message: string) => {
        resultsHeading.textContent = message
      }

      const clearResults = () => resultsContainer.replaceChildren()

      const renderResults = (results: SearchResult[], total: number) => {
        clearResults()

        for (const result of results.slice(0, RESULT_LIMIT)) {
          const item = document.createElement('li')
          const link = document.createElement('a')
          const excerpt = document.createElement('div')

          item.classList.add('fade-in-up')
          link.className = 'text-xl font-normal'
          link.href = result.url
          link.textContent = result.title
          excerpt.className = 'mt-4 opacity-75'
          excerpt.textContent = result.excerpt
          item.append(link, excerpt)
          resultsContainer.append(item)
        }

        if (total > RESULT_LIMIT) {
          const remaining = document.createElement('li')
          remaining.classList.add('fade-in-up')
          remaining.textContent = `另有 ${total - RESULT_LIMIT} 条结果`
          resultsContainer.append(remaining)
        }

        setStatus(`找到 ${total} 篇文章`)
      }

      const searchWithPagefind = async (
        pagefind: PagefindApi,
        query: string
      ): Promise<{ results: SearchResult[]; total: number }> => {
        const response = await pagefind.search(query, {
          filters: { type: 'post' }
        })
        const resultData = await Promise.all(
          response.results.slice(0, RESULT_LIMIT).map((result) => result.data())
        )

        return {
          total: response.results.length,
          results: resultData.map((data) => ({
            title: data.meta.title,
            excerpt: toPlainText(data.excerpt),
            url: data.url
          }))
        }
      }

      const runSearch = async (query: string, currentRequestId: number) => {
        setStatus('正在搜索…')
        clearResults()

        try {
          const pagefind = await (window.pagefindPromise ??
            Promise.resolve(window.pagefind ?? null))
          let searchResponse: { results: SearchResult[]; total: number }

          if (pagefind) {
            try {
              searchResponse = await searchWithPagefind(pagefind, query)
            } catch {
              const results = searchDocuments(documents, query)
              searchResponse = { results, total: results.length }
            }
          } else {
            const results = searchDocuments(documents, query)
            searchResponse = { results, total: results.length }
          }

          if (currentRequestId !== this.requestId) return

          if (searchResponse.total === 0) {
            setStatus('没有找到相关文章')
            clearResults()
            return
          }

          renderResults(searchResponse.results, searchResponse.total)
        } catch {
          if (currentRequestId !== this.requestId) return
          setStatus('搜索暂时不可用，请稍后重试')
          clearResults()
        }
      }

      const onInput = () => {
        const query = searchInput.value.trim()
        const currentRequestId = ++this.requestId

        window.clearTimeout(this.timeoutId)
        clearBtn.classList.toggle('invisible', query.length === 0)

        if (!query) {
          setStatus('输入关键词搜索文章')
          clearResults()
          return
        }

        this.timeoutId = window.setTimeout(
          () => void runSearch(query, currentRequestId),
          SEARCH_DELAY
        )
      }

      searchInput.addEventListener('input', onInput)
      clearBtn.addEventListener('click', () => {
        searchInput.value = ''
        onInput()
        searchInput.focus()
      })
    }

    disconnectedCallback() {
      window.clearTimeout(this.timeoutId)
      this.requestId += 1
    }
  }

  if (!customElements.get('search-input'))
    customElements.define('search-input', SearchInput)
</script>
