---
import PageLayout, {
  type Props as PageLayoutProps,
} from "@/layouts/PageLayout.astro";
import { generateTags, getTagUsage } from "@/util/tags";
import { getPosts } from "@/util/posts";

const tags = await generateTags();
const totalPosts = (await getPosts()).length;

const tagsWithUsage = await Promise.all(
  tags.map(async (t) => ({
    ...t,
    usage: await getTagUsage(t.tag),
  }))
);

// 按文章数量降序排序，数量相同按字母排序
tagsWithUsage.sort((a, b) => b.usage - a.usage || a.tag.localeCompare(b.tag));

const frontmatter: PageLayoutProps["frontmatter"] = {
  title: "标签",
  description: `按 ${tagsWithUsage.length} 个技术标签浏览 TaiWei 的 ${totalPosts} 篇前端开发、工程化与 AI 编码实践文章。`,
  activeHeaderLink: "标签",
};
---

<PageLayout {frontmatter}>
  <div class="mb-10 pb-4 hairline-bottom">
    <h1 class="font-sans text-2xl sm:text-3xl font-semibold tracking-tight text-title">
      标签
    </h1>
    <p class="mt-2 text-sm text-muted font-sans">
      共 {tagsWithUsage.length} 个技术维度与分类。
    </p>
  </div>

  <div class="not-prose grid grid-cols-2 sm:grid-cols-3 gap-3">
    {
      tagsWithUsage.map(({ tag, usage }) => (
        <a
          class="group p-3 rounded-lg subtle-card flex items-center justify-between no-underline"
          href={`/tags/${tag}/`}
          data-astro-prefetch
        >
          <span class="font-sans text-sm text-body group-hover:text-title transition-colors truncate">
            #{tag}
          </span>
          <span class="font-mono text-xs text-muted group-hover:text-title">
            {usage}
          </span>
        </a>
      ))
    }
  </div>
</PageLayout>
