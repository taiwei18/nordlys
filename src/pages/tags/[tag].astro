---
import PostsList from '@/components/posts/PostsList.astro'
import PageLayout, {
  type Props as PageLayoutProps
} from '@/layouts/PageLayout.astro'
import { getPosts } from '@/util/posts'
import { generateTags } from '@/util/tags'
import type { InferGetStaticPropsType } from 'astro'

const {
  tag: { tag, icon }
} = Astro.props

type Props = InferGetStaticPropsType<typeof getStaticPaths>

export async function getStaticPaths() {
  const tags = await generateTags()

  return tags.map(({ tag, icon }) => ({
    params: { tag },
    props: { tag: { tag, icon } }
  }))
}

const posts = await getPosts(tag)

const frontmatter: PageLayoutProps['frontmatter'] = {
  title: `标签：${tag}`,
  description: `浏览 TaiWei 关于 ${tag} 的 ${posts.length} 篇技术文章与工程实践记录。`,
  activeHeaderLink: '标签'
}
---

<PageLayout {frontmatter}>
  <div slot="top" class="mb-8">
    <a
      href="/tags/"
      class="group inline-flex items-center gap-1.5 font-mono text-xs text-muted hover:text-title transition-colors"
    >
      <span class="iconify tabler--arrow-left text-sm transition-transform duration-200 group-hover:-translate-x-0.5"></span>
      <span>所有标签</span>
    </a>
  </div>

  <div class="mb-10 pb-4 hairline-bottom">
    <h1 class="font-sans text-2xl sm:text-3xl font-semibold tracking-tight text-title">
      #{tag}
    </h1>
    <p class="font-mono text-xs text-muted mt-1">收录 {posts.length} 篇文章</p>
  </div>

  <div class="not-prose">
    <PostsList {posts} />
  </div>
</PageLayout>
