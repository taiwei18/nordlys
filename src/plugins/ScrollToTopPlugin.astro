<scroll-top-button
  id="scroll-to-top"
  class="fixed! right-4 bottom-4 z-40 pointer-events-none opacity-0 translate-y-4 scale-90 transition-all duration-300 ease-out sm:right-8 sm:bottom-8 lg:right-12 lg:bottom-12"
>
  <button
    class="group flex h-11 w-11 items-center justify-center rounded-full border border-accent/25 bg-accent-bg/80 text-accent backdrop-blur-md shadow-md shadow-black/5 transition-all duration-200 hover:-translate-y-1 hover:border-accent/60 hover:bg-accent/15 hover:shadow-lg hover:shadow-accent/10 active:scale-90 cursor-pointer"
    title="Scroll to top"
    aria-label="Scroll to top"
  >
    <span
      aria-hidden="true"
      class="iconify tabler--arrow-up text-2xl transition-transform duration-300 ease-out group-hover:-translate-y-0.5"
    ></span>
  </button>
</scroll-top-button>

<script>
  function setupScrollToTop() {
    const container = document.getElementById('scroll-to-top')
    if (!container) return
    const button = container.querySelector('button')
    if (!button) return

    function isBelowViewport() {
      const minHeight = window.innerHeight * 0.5
      const scrollTop =
        document.body.scrollTop || document.documentElement.scrollTop
      return scrollTop > minHeight
    }

    const updateVisibility = () => {
      if (isBelowViewport()) {
        container.classList.remove('pointer-events-none', 'opacity-0', 'translate-y-4', 'scale-90')
        container.classList.add('pointer-events-auto', 'opacity-100', 'translate-y-0', 'scale-100')
      } else {
        container.classList.add('pointer-events-none', 'opacity-0', 'translate-y-4', 'scale-90')
        container.classList.remove('pointer-events-auto', 'opacity-100', 'translate-y-0', 'scale-100')
      }
    }

    button.onclick = () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      })
    }

    window.addEventListener('scroll', updateVisibility, { passive: true })
    updateVisibility()
  }

  document.addEventListener('astro:page-load', setupScrollToTop)
  setupScrollToTop()
</script>
